# Token partagé Agent <-> Panel (dev local, amorçage avant enrôlement).
# Minimum 32 caractères. Doit être identique à :
#   - apps/panel/.env.local          -> AGENT_TOKEN
# N'est plus accepté par l'Agent une fois enrôlé (token permanent local
# pris en compte à la place) — y compris sur /traefik/config, voir
# TRAEFIK_TOKEN ci-dessous.
AGENT_TOKEN=dev_agent_change_me_to_a_long_random_string

# Token dédié à Traefik, distinct d'AGENT_TOKEN. Traefik n'a pas de
# notion de token permanent (contrairement au Panel) : sans un secret
# séparé, il perdrait l'accès à GET /traefik/config dès que l'Agent est
# enrôlé. Minimum 32 caractères, à générer aléatoirement. Doit être
# identique à docker/traefik/.env -> TRAEFIK_TOKEN. N'ouvre l'accès à
# aucune autre route (/sites, /databases, /backups, etc.).
TRAEFIK_TOKEN=dev_traefik_change_me_to_a_long_random_string

# URL du Panel, utilisée pour le heartbeat (défaut : http://localhost:3001)
PANEL_URL=http://localhost:3001

# --- Uniquement pour `pnpm enroll` (enrôlement d'un Agent distant) ---
# AGENT_URL=https://agent.exemple.com
# ENROLLMENT_TOKEN=...
# AGENT_HOSTNAME=vps-xxxxxxxx
