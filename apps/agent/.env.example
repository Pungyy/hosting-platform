# Token partagé Agent <-> Panel <-> Traefik (dev local).
# Minimum 32 caractères. Doit être identique à :
#   - apps/panel/.env.local          -> AGENT_TOKEN
#   - docker/traefik/.env            -> AGENT_TOKEN
AGENT_TOKEN=dev_agent_change_me_to_a_long_random_string

# URL du Panel, utilisée pour le heartbeat (défaut : http://localhost:3001)
PANEL_URL=http://localhost:3001

# --- Uniquement pour `pnpm enroll` (enrôlement d'un Agent distant) ---
# AGENT_URL=https://agent.exemple.com
# ENROLLMENT_TOKEN=...
# AGENT_HOSTNAME=vps-xxxxxxxx
