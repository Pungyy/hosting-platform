# Base de données dédiée aux tests d'intégration (chargeurs de ressources,
# vérification d'isolation entre utilisateurs). Copier vers .env.test et
# renseigner les valeurs réelles.
#
# hosting_platform_test_user / hosting_platform_test sont un rôle et une base
# Postgres COMPLETEMENT séparés du rôle et de la base de développement
# (hosting_platform_user / hosting_platform) :
#   - hosting_platform_test_user est NOSUPERUSER, NOCREATEDB, NOCREATEROLE.
#   - hosting_platform_test_user ne possède AUCUN privilège sur les tables ou
#     le schéma de hosting_platform : vérifié empiriquement, un
#     `SELECT * FROM users` depuis ce rôle sur hosting_platform échoue avec
#     « permission denied for table users ».
#   - Particularité connue et acceptée : ce rôle peut techniquement OUVRIR une
#     connexion à hosting_platform (privilège CONNECT hérité de PUBLIC, jamais
#     retiré de hosting_platform pour ne pas risquer l'accès de
#     hosting_platform_user). Ça ne lui donne accès à aucune donnée — voir
#     apps/panel/src/test/testDatabase.ts pour le détail.
#   - hosting_platform_test_user n'est utilisé QUE par le pool de test
#     (testPool), et QUE contre hosting_platform_test.
#
# Le code de test lit exclusivement les variables TEST_DATABASE_* ci-dessous —
# aucun repli vers DATABASE_* n'existe : si une seule de ces variables manque,
# les tests échouent immédiatement au chargement du module.

TEST_DATABASE_HOST=localhost
TEST_DATABASE_PORT=55432
TEST_DATABASE_NAME=hosting_platform_test
TEST_DATABASE_USER=hosting_platform_test_user
TEST_DATABASE_PASSWORD=change_me
