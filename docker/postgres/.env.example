# Copier vers .env (chmod 600) et renseigner de vraies valeurs générées
# aléatoirement (ex: openssl rand -hex 32). Ne jamais committer .env.

POSTGRES_DB=hosting_platform

# Rôle bootstrap du cluster (créé par initdb) — reste superuser en
# permanence, mais c'est une contrainte structurelle de PostgreSQL ("the
# bootstrap user must have the SUPERUSER attribute"), jamais un rôle du
# projet. Utilisé UNIQUEMENT lors de l'installation initiale, jamais par
# le Panel ni par les migrations courantes.
POSTGRES_ROOT_PASSWORD=change_me

# Rôle propriétaire de la base / exécutant les migrations. NOSUPERUSER
# dès sa création (jamais superuser, à aucun moment) — créé séparément du
# rôle bootstrap ci-dessus, propriétaire de la base et du schéma public,
# ce qui suffit pour toutes les migrations (001 à 014). Ne doit jamais
# être utilisé par le Panel en runtime.
POSTGRES_MIGRATOR_USER=hosting_platform_migrator
POSTGRES_MIGRATOR_PASSWORD=change_me

# Rôle utilisé par le Panel en runtime (voir apps/panel/.env.example :
# DATABASE_USER). NOSUPERUSER, NOCREATEDB, NOCREATEROLE en permanence.
POSTGRES_APP_USER=hosting_platform_app
POSTGRES_APP_PASSWORD=change_me
